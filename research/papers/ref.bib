@misc{beniTesseractSearchBasedDecoder2025,
  title = {Tesseract: {{A Search-Based Decoder}} for {{Quantum Error Correction}}},
  shorttitle = {Tesseract},
  author = {Beni, Laleh Aghababaie and Higgott, Oscar and Shutty, Noah},
  year = 2025,
