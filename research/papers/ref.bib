@misc{korhonenAlmostlinearTimeParameterized2024,
  title = {Almost-Linear Time Parameterized Algorithm for Rankwidth via Dynamic Rankwidth},
  author = {Korhonen, Tuukka and Soko{\l}owski, Marek},
