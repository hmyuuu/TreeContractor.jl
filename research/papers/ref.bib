  urldate = {2025-12-11},
  abstract = {Linear rank-width is a linearized variation of rank-width, and it is deeply related to matroid path-width. In this paper, we show that the linear rank-width of every n-vertex distance-hereditary graph, equivalently a graph of rank-width at most 1, can be computed in time Opn2 \textasciidieresis{} log2 nq, and a linear layout witnessing the linear rank-width can be computed with the same time complexity. As a corollary, we show that the path-width of every n-element matroid of branch-width at most 2 can be computed in time Opn2 \textasciidieresis{} log2 nq, provided that the matroid is given by its binary representation.},
  langid = {english},
  keywords = {rank-width},
