  doi = {10.48550/arXiv.0705.1384},
  urldate = {2025-12-11},
  abstract = {We relate the notion of matroid pathwidth to the minimum trellis state-complexity (which we term trellis-width) of a linear code, and to the pathwidth of a graph. By reducing from the problem of computing the pathwidth of a graph, we show that the problem of determining the pathwidth of a representable matroid is NP-hard. Consequently, the problem of computing the trellis-width of a linear code is also NP-hard. For a finite field \$\textbackslash F\$, we also consider the class of \$\textbackslash F\$-representable matroids of pathwidth at most \$w\$, and correspondingly, the family of linear codes over \$\textbackslash F\$ with trellis-width at most \$w\$. These are easily seen to be minor-closed. Since these matroids (and codes) have branchwidth at most \$w\$, a result of Geelen and Whittle shows that such matroids (and the corresponding codes) are characterized by finitely many excluded minors. We provide the complete list of excluded minors for \$w=1\$, and give a partial list for \$w=2\$.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Discrete Mathematics,Computer Science - Information Theory,rank-width},
  file = {/Users/hmyuuu/Zotero/storage/8IT3XWAH/Kashyap - 2007 - Matroid Pathwidth and Code Trellis Complexity.pdf;/Users/hmyuuu/Zotero/storage/S3NIWTSX/0705.html}
}

