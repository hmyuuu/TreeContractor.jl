  eprint = {2004.14789},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2004.14789},
  urldate = {2025-11-28},
  abstract = {Inspired by a width invariant defined on permutations by Guillemot and Marx [SODA '14], we introduce the notion of twin-width on graphs and on matrices. Proper minor-closed classes, bounded rank-width graphs, map graphs, \$K\_t\$-free unit \$d\$-dimensional ball graphs, posets with antichains of bounded size, and proper subclasses of dimension-2 posets all have bounded twin-width. On all these classes (except map graphs without geometric embedding) we show how to compute in polynomial time a sequence of \$d\$-contractions, witness that the twin-width is at most \$d\$. We show that FO model checking, that is deciding if a given first-order formula \${$\varphi\$$} evaluates to true for a given binary structure \$G\$ on a domain \$D\$, is FPT in \$\textbar{$\varphi\vert\$$} on classes of bounded twin-width, provided the witness is given. More precisely, being given a \$d\$-contraction sequence for \$G\$, our algorithm runs in time \$f(d,\textbar{$\varphi\vert$}) \textbackslash cdot \textbar D\textbar\$ where \$f\$ is a computable but non-elementary function. We also prove that bounded twin-width is preserved by FO interpretations and transductions (allowing operations such as squaring or complementing a graph). This unifies and significantly extends the knowledge on fixed-parameter tractability of FO model checking on non-monotone classes, such as the FPT algorithm on bounded-width posets by Gajarsk\'y et al. [FOCS '15].},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Data Structures and Algorithms,Computer Science - Discrete Mathematics,Computer Science - Logic in Computer Science,rank-width},
  file = {/Users/hmyuuu/Zotero/storage/NDJG8ADU/Bonnet et al. - 2021 - Twin-width I tractable FO model checking.pdf;/Users/hmyuuu/Zotero/storage/AN3YI88T/2004.html}
