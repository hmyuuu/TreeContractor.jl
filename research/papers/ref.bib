@misc{yeTensorNetworkRanks2019,
  title = {Tensor Network Ranks},
  author = {Ye, Ke and Lim, Lek-Heng},
  year = 2019,
  month = feb,
  number = {arXiv:1801.02662},
  eprint = {1801.02662},
  primaryclass = {math},
  publisher = {arXiv},
  doi = {10.48550/arXiv.1801.02662},
  urldate = {2025-12-11},
  abstract = {In problems involving approximation, completion, denoising, dimension reduction, estimation, interpolation, modeling, order reduction, regression, etc, we argue that the near-universal practice of assuming that a function, matrix, or tensor (which we will see are all the same object in this context) has \textbackslash emph\textbraceleft low rank\textbraceright{} may be ill-justified. There are many natural instances where the object in question has high rank with respect to the classical notions of rank: matrix rank, tensor rank, multilinear rank --- the latter two being the most straightforward generalizations of the former. To remedy this, we show that one may vastly expand these classical notions of ranks: Given any undirected graph \$G\$, there is a notion of \$G\$-rank associated with \$G\$, which provides us with as many different kinds of ranks as there are undirected graphs. In particular, the popular tensor network states in physics (e.g., \textbackslash textsc\textbraceleft mps\textbraceright, \textbackslash textsc\textbraceleft ttns\textbraceright, \textbackslash textsc\textbraceleft peps\textbraceright ) may be regarded as functions of a specific \$G\$-rank for various choices of \$G\$. Among other things, we will see that a function, matrix, or tensor may have very high matrix, tensor, or multilinear rank and yet very low \$G\$-rank for some \$G\$. In fact the difference is in the orders of magnitudes and the gaps between \$G\$-ranks and these classical ranks are arbitrarily large for some important objects in computer science, mathematics, and physics. Furthermore, we show that there is a \$G\$ such that almost every tensor has \$G\$-rank exponentially lower than its rank or the dimension of its ambient space.},
  archiveprefix = {arXiv},
  keywords = {Mathematics - Numerical Analysis,rank-width},
  file = {/Users/hmyuuu/Zotero/storage/AFSKZWTA/Ye and Lim - 2019 - Tensor network ranks.pdf;/Users/hmyuuu/Zotero/storage/KFZ3EI6N/1801.html}
}
